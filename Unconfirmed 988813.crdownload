/* CULUSOOW service worker
 * - Precaches the app shell + CDN libraries so the app opens offline.
 * - HTML pages: network-first, falling back to the cached shell.
 * - Static assets (own files, CDN scripts/styles/fonts): stale-while-revalidate.
 * - Supabase (auth, REST, realtime, storage) and every non-GET request are
 *   NEVER touched: the browser handles them directly, so live data stays live.
 * Bump CACHE_VERSION whenever you deploy a new version of the app.
 */
const CACHE_VERSION = 'v1';
const CACHE = 'culusoow-' + CACHE_VERSION;

// Own files (relative to this sw.js). Missing files are skipped, not fatal.
const APP_SHELL = [
  './',
  'index.html',
  'index_17.html',
  'manifest.json',
  'icon-192x192.png',
  'icon-512x512.png'
];

// Third-party libraries the app needs to render (fetched as opaque no-cors).
const CDN_ASSETS = [
  'https://cdn.tailwindcss.com',
  'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css',
  'https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js',
  'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js',
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap'
];

// Hosts that are cached on first use (stale-while-revalidate).
const CACHEABLE_HOSTS = [
  'cdn.tailwindcss.com',
  'cdnjs.cloudflare.com',
  'cdn.jsdelivr.net',
  'fonts.googleapis.com',
  'fonts.gstatic.com'
];

self.addEventListener('install', (event) => {
  event.waitUntil((async () => {
    const cache = await caches.open(CACHE);
    await Promise.allSettled([
      ...APP_SHELL.map((url) => cache.add(new Request(url, { cache: 'reload' }))),
      ...CDN_ASSETS.map((url) => cache.add(new Request(url, { mode: 'no-cors' })))
    ]);
    // New worker takes over as soon as the page allows it (see message handler).
  })());
});

self.addEventListener('activate', (event) => {
  event.waitUntil((async () => {
    const keys = await caches.keys();
    await Promise.all(
      keys.filter((k) => k.startsWith('culusoow-') && k !== CACHE).map((k) => caches.delete(k))
    );
    await self.clients.claim();
  })());
});

self.addEventListener('message', (event) => {
  if (event.data === 'SKIP_WAITING') self.skipWaiting();
});

self.addEventListener('fetch', (event) => {
  const req = event.request;
  if (req.method !== 'GET') return;                         // inserts/updates/deletes
  const url = new URL(req.url);
  if (url.protocol !== 'http:' && url.protocol !== 'https:') return;
  if (url.hostname.endsWith('.supabase.co') || url.hostname.endsWith('.supabase.in')) return; // live API
  if (req.headers.has('range')) return;                     // media range requests

  // Page navigations: network first, offline fallback to cached shell.
  if (req.mode === 'navigate') {
    event.respondWith((async () => {
      try {
        const fresh = await fetch(req);
        if (fresh && fresh.ok) {
          const cache = await caches.open(CACHE);
          cache.put(req, fresh.clone());
        }
        return fresh;
      } catch (err) {
        const cache = await caches.open(CACHE);
        return (
          (await cache.match(req, { ignoreSearch: true })) ||
          (await cache.match('./')) ||
          (await cache.match('index.html')) ||
          (await cache.match('index_17.html')) ||
          new Response('Offline', { status: 503, headers: { 'Content-Type': 'text/plain' } })
        );
      }
    })());
    return;
  }

  const sameOrigin = url.origin === self.location.origin;
  if (!sameOrigin && !CACHEABLE_HOSTS.includes(url.hostname)) return;

  // Static assets: serve from cache, refresh in the background.
  event.respondWith((async () => {
    const cache = await caches.open(CACHE);
    const cached = await cache.match(req);
    const network = fetch(req)
      .then((res) => {
        if (res && (res.ok || res.type === 'opaque')) cache.put(req, res.clone());
        return res;
      })
      .catch(() => null);
    if (cached) { event.waitUntil(network); return cached; }
    return (await network) || new Response('', { status: 504 });
  })());
});
